          "rawSql": "SELECT \n    $__timeGroup(run_completed_at, '$__interval') as time,\n    ROUND(AVG(execution_time_seconds)::numeric, 3) as \"Avg Test Duration (sec)\",\n    ROUND(MAX(execution_time_seconds)::numeric, 3) as \"Max Test Duration (sec)\", \n    ROUND(PERCENTILE_CONT(0.95) WITHIN GROUP (\n        ORDER BY execution_time_seconds\n    )::numeric, 3) as \"95th Percentile (sec)\"\nFROM monitoring.dbt_test_results \nWHERE $__timeFilter(run_completed_at)\n    AND status != 'skip'\nGROUP BY time\nORDER BY time;",
