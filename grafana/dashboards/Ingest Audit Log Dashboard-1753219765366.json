          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH model_tests AS (\n    SELECT \n        model_name,\n        COUNT(DISTINCT test_name) as total_tests,\n        COUNT(DISTINCT CASE WHEN status = 'pass' THEN test_name END) as passing_tests,\n        COUNT(DISTINCT CASE WHEN status = 'fail' THEN test_name END) as failing_tests\n    FROM monitoring.dbt_test_results \n    WHERE run_completed_at >= NOW() - INTERVAL '7 days'\n        AND model_name IS NOT NULL\n    GROUP BY model_name\n)\nSELECT \n    model_name,\n    total_tests,\n    passing_tests,\n    failing_tests,\n    ROUND((passing_tests * 100.0 / total_tests), 1) as pass_rate_percent\nFROM model_tests\nWHERE total_tests > 0\nORDER BY total_tests DESC, pass_rate_percent ASC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
