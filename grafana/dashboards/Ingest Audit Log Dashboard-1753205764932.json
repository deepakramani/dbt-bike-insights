          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    $__timeGroup(load_timestamp, '$__interval') as time,\n    ROUND(\n        (COUNT(CASE WHEN status = 'success' THEN 1 END) * 100.0 / COUNT(*)), 2\n    ) as \"Success Rate (%)\",\n    ROUND(\n        (COUNT(CASE WHEN status = 'failed' THEN 1 END) * 100.0 / COUNT(*)), 2  \n    ) as \"Failure Rate (%)\",\n    ROUND(\n        (COUNT(CASE WHEN status = 'timeout' THEN 1 END) * 100.0 / COUNT(*)), 2\n    ) as \"Timeout Rate (%)\"\nFROM monitoring.ingest_audit_log  \nWHERE $__timeFilter(load_timestamp)\nGROUP BY time\nORDER BY time;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
